[Unit]
Description=VC Client HTTP Server (start when mic and speaker are ready)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
###############################################################################
# Service type:
# - simple: ExecStart is the main long-running process
###############################################################################
Type=simple

###############################################################################
# Wait until both microphone and speaker are available before starting vcclient
###############################################################################
ExecStartPre=%h/conan-style-voice-changer-mic-speaker/raspi5/local/wait-for-audio-devices.sh

###############################################################################
# Start the HTTP server
# This process is expected to run indefinitely
###############################################################################
WorkingDirectory=%h/vcclient/dist
ExecStart=/bin/bash -lc './start_http.sh'

###############################################################################
# Post-start orchestration:
# - Always wait 15 seconds (warm-up window right after process start)
# - Then poll the API readiness (status check)
# - Perform browser-like warm-up GETs
# - POST start
# - Play startup sound only if start succeeds
###############################################################################
ExecStartPost=%h/.local/bin/vcclient-autostart.sh

###############################################################################
# Restart policy:
# - Restart only if the server crashes or exits with an error
###############################################################################
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=0

###############################################################################
# Log output to the systemd journal
###############################################################################
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

